digraph Iterator {
  graph [rankdir=TB, bgcolor="white", pad="0.20", nodesep="0.40", ranksep="0.48", splines=polyline, fontname="Liberation Sans", label="Iterator · Recorrido de posiciones e historial", labelloc=t, fontsize=18, fontcolor="#312e81"];
  node [shape=plain, fontname="Liberation Sans", fontsize=13];
  edge [fontname="Liberation Sans", fontsize=11, color="#6d5ba6", fontcolor="#4c1d95", arrowsize=0.85, penwidth=1.2];
  pages [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#f5f3ff"><TR><TD><B>OrdersPage / PortfoliosPage</B></TD></TR><HR/><TR><TD>mostrar_historial() · mostrar_posiciones()</TD></TR></TABLE>>];
  aggregate [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#ede9fe"><TR><TD><B>ColeccionTrading</B></TD></TR><HR/><TR><TD>_elementos: tuple</TD></TR><TR><TD>__iter__() · __len__()</TD></TR></TABLE>>];
  iterator [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#ddd6fe"><TR><TD><B>IteradorTrading</B></TD></TR><HR/><TR><TD>_indice · _elementos</TD></TR><TR><TD>__iter__() · __next__()</TD></TR></TABLE>>];
  items [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#f5f3ff"><TR><TD><B>Elementos</B></TD></TR><HR/><TR><TD>Posicion · OrdenRegistro</TD></TR></TABLE>>];
  {rank=same; pages; aggregate;}
  {rank=same; iterator; items;}
  pages -> aggregate [label="solicita recorrido"];
  aggregate -> iterator [label="crea"];
  iterator -> items [label="entrega uno a uno"];
}
