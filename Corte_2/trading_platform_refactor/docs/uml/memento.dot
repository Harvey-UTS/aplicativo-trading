digraph Memento {
  graph [rankdir=TB, bgcolor="white", pad="0.20", nodesep="0.40", ranksep="0.48", splines=polyline, fontname="Liberation Sans", label="Memento · Puntos de control de la cartera", labelloc=t, fontsize=18, fontcolor="#312e81"];
  node [shape=plain, fontname="Liberation Sans", fontsize=13];
  edge [fontname="Liberation Sans", fontsize=11, color="#6d5ba6", fontcolor="#4c1d95", arrowsize=0.85, penwidth=1.2];
  service [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#f5f3ff"><TR><TD><B>PortfolioService</B></TD></TR><HR/><TR><TD>guardar_punto_control() · restaurar_ultimo_estado()</TD></TR></TABLE>>];
  caretaker [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#ede9fe"><TR><TD><B>HistorialCartera (Caretaker)</B></TD></TR><HR/><TR><TD>_estados · _capacidad</TD></TR><TR><TD>guardar() · deshacer() · listar()</TD></TR></TABLE>>];
  memento [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#ddd6fe"><TR><TD><B>CarteraMemento</B></TD></TR><HR/><TR><TD>_estado privado · motivo · creado_en</TD></TR><TR><TD>restaurar(cartera)</TD></TR></TABLE>>];
  originator [label=<<TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#f5f3ff"><TR><TD><B>Cartera (Originator)</B></TD></TR><HR/><TR><TD>saldo_usd · activos · configuración_riesgo</TD></TR></TABLE>>];
  {rank=same; service; caretaker;}
  {rank=same; memento; originator;}
  service -> caretaker [label="administra"];
  caretaker -> memento [label="conserva"];
  memento -> originator [label="restaura"];
}
